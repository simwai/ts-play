{
  "extends": "@sindresorhus/tsconfig",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ESNext", "WebWorker", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "erasableSyntaxOnly": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
